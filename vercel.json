{
    "version": 2,
    "framework": null,
    "functions": {
      "api/index.php": { "runtime": "vercel-php@0.7.3" }
    },
    "routes": [
      { "src": "/build/(.*)", "dest": "/public/build/$1" },
      { "src": "/(.*\\.(js|css|png|jpg|jpeg|svg|ico|webp|woff2?))", "dest": "/public/$1" },
      { "src": "/(.*)", "dest": "/api/index.php" }
    ]
  }
